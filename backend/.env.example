# ─── CodeLooter Backend .env (DEVELOPMENT) ───
# Copy ke backend/.env dan isi dengan nilai sebenarnya.

# Supabase project — buat di https://supabase.com/dashboard
# Settings → API → Project URL, anon public, service_role
CL_SUPABASE_URL=https://your-project.supabase.co
CL_SUPABASE_ANON_KEY=eyJhbGciOi...
CL_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# JWT — generate dengan: openssl rand -base64 48
# PENTING: minimal 32 karakter, jangan pakai "change-me"
CL_JWT_SECRET=generate-with-openssl-rand-base64-48

# CORS — tambahkan URL Vercel Anda (FE)
# Untuk dev lokal:
#   CL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Untuk production (pisah dengan koma):
#   CL_CORS_ORIGINS=["https://codelooter.vercel.app","https://www.codelooter.vercel.app"]
CL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File upload limit (MB)
CL_MAX_UPLOAD_MB=50
