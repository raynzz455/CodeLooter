# CodeLooter Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy file ini ke backend/.env (untuk dev lokal) atau set semua variabel
# di Render dashboard (untuk production).
#
# File .env JANGAN di-commit ke git (sudah di .gitignore).
# File ini (.env.example) aman di-commit sebagai dokumentasi.
# ─────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────
# Buat project di https://supabase.com, lalu ambil dari:
# Dashboard → Settings → API

# URL project Supabase Anda.
# Format: https://<project-ref>.supabase.co
CL_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (anon key). Aman di-expose ke client karena RLS aktif.
# Format lama: eyJhbGciOi... (JWT format)
# Format baru: sb_publishable_p0-... (string polos, didukung supabase-py >= 2.31)
CL_SUPABASE_ANON_KEY=sb_publishable_p0-your-anon-key

# Service role key. RAHASIA — hanya untuk backend!
# Bypass RLS, jadi siapa pun yang punya key ini bisa akses semua data.
# JANGAN PERNAH commit ke git atau share ke FE.
# Dari: Dashboard → Settings → API → service_role key
CL_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# ─── JWT ─────────────────────────────────────────────────────
# Secret untuk sign JWT (untuk auth session user).
# Generate dengan: openssl rand -base64 48
# Minimal 32 karakter. Jangan pakai string default!
CL_JWT_SECRET=generate-with-openssl-rand-base64-48

# ─── CORS ────────────────────────────────────────────────────
# Whitelist origin yang boleh panggil API. Format JSON array.
# Untuk dev lokal:
#   CL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Untuk production (setelah Vercel deploy):
#   CL_CORS_ORIGINS=["https://codelooter.vercel.app"]
# Untuk multiple domain:
#   CL_CORS_ORIGINS=["https://codelooter.vercel.app","https://www.codelooter.vercel.app"]
CL_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── File Upload ─────────────────────────────────────────────
# Maksimal ukuran file upload (dalam MB).
# Default: 50 MB. Sesuaikan dengan limit Render free tier (100 MB).
CL_MAX_UPLOAD_MB=50

# ─── Catatan Penting ────────────────────────────────────────
# 1. Untuk production (Render): set semua variabel di dashboard Render,
#    bukan pakai file .env. Render baca dari env vars, bukan file.
# 2. Jangan commit file .env asli ke git. Hanya .env.example yang aman.
# 3. Setelah ganti CL_JWT_SECRET, semua token JWT lama menjadi invalid.
#    User harus login ulang.
# 4. CL_SUPABASE_SERVICE_ROLE_KEY adalah rahasia. Kalau bocor:
#    - Segera revoke di Supabase dashboard
#    - Generate key baru
#    - Update env var di Render
# 5. Test koneksi setelah setup:
#    cd backend
#    python3 -c "
#    from app.supabase_client import get_supabase_admin
#    admin = get_supabase_admin()
#    print(admin.table('profiles').select('id').limit(1).execute())
#    "
